{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Indigo Invoicing API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/indigo-services/indigo-invoicing-service/Indigo.Invoicing.API/bin/Debug/net8.0/Indigo.Invoicing.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/indigo-services/indigo-invoicing-service/Indigo.Invoicing.API",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
} 